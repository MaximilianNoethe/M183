# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Dashboard HTTP Basic Auth (Week 3+)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=changeme

# Flask
SECRET_KEY=change-me-to-a-long-random-string
FLASK_ENV=production

# Paths
COWRIE_LOG_PATH=/opt/honeypot/cowrie/var/log/cowrie/cowrie.json
DATABASE_PATH=honeypot.db

# GeoIP (ip-api.com is keyless; this is here for future provider swaps)
GEOIP_ENDPOINT=http://ip-api.com/json/

# Token auth (Week 6 upgrade)
API_TOKEN=change-me-to-a-long-random-token

# Request log file (optional; logs to stderr/journald if unset)
API_LOG_PATH=/var/log/honeypot/api.log
